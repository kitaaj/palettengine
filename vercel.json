{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix web/frontend ci && npm --prefix web/frontend run build",
  "outputDirectory": "web/frontend/dist",
  "framework": null,
  "functions": {
    "api/index.py": {
      "includeFiles": "palettengine/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/list/(.*)", "destination": "/api/index" },
    { "source": "/docs", "destination": "/api/index" },
    { "source": "/openapi.json", "destination": "/api/index" }
  ]
}
